# Скопируй в .env и заполни. Файл .env в git не попадает.

# Токен от @BotFather (старый токен засвечен в публичном репозитории — выпусти новый: /revoke)
TELEGRAM_BOT_TOKEN=

# Clash of Clans API: либо готовый ключ под статический IP сервера...
COC_API_KEY=
# ...либо аккаунт developer.clashofclans.com — бот сам создаёт ключ под свой IP
COC_EMAIL=
COC_PASSWORD=
# COC_PROXY=http://логин:пароль@адрес:порт

# Клан
CLAN_TAG=#2R02GGRUJ
CLAN_BRAND=WarFil
CLAN_WEBSITE=https://www.warfilcoc.ru
TG_GROUP_LINK=https://t.me/warfil_clan
ADMIN_USERNAME=feolar

# Сводка атак во время войны каждые N минут (0 — выключить)
WAR_DIGEST_MINUTES=120
CWL_DIGEST_MINUTES=0
RAID_DIGEST_MINUTES=0

# Пак кастомных эмодзи по CoC: имя из ссылки t.me/addemoji/<имя>
# (нужен Telegram Premium у владельца бота; без него будут обычные эмодзи)
EMOJI_PACK=
